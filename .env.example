# =================================================================
# Lead Scraper Configuration
# Set your chosen LLM API Key below
# =================================================================

# Google Gemini (Recommended - Generous free tier from Google AI Studio)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (For GPT-4o, GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq Cloud API Key (Fast inference with Llama 3 models)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Local Ollama URL (Default: http://localhost:11434)
# If using Ollama locally with llama3.2, no API key is required
OLLAMA_BASE_URL=http://localhost:11434
